# Copy to .env. Generate the key with: openssl rand -hex 32
VOX_SECRET_KEY=
# JSON list of emails that get the admin dashboard
VOX_ADMIN_EMAILS=["admin@voxagent.local"]
# Google sign-in: OAuth "Web application" client id. Leave empty to hide the button.
VOX_GOOGLE_CLIENT_ID=
# Providers, first is primary, the rest are fallbacks.
# cloud:<model> is any OpenAI-compatible API: glm-4.5-flash is free on Z.ai,
# openai/gpt-oss-120b is free on Groq. ollama stays as the local fallback.
VOX_LLM=cloud:glm-4.5-flash,ollama:llama3.2
VOX_LLM_BASE_URL=https://api.z.ai/api/paas/v4
# Free key from https://z.ai/manage-apikey/apikey-list
VOX_LLM_API_KEY=
VOX_STT=whisper:small
VOX_TTS=say
VOX_OLLAMA_URL=http://localhost:11434
VOX_DATABASE_URL=sqlite:///./voxagent.db

# ---- Workspaces and running code
# docker = isolated container per command (production; build the image from sandbox/Dockerfile)
# seatbelt = macOS sandbox-exec for local development without Docker; off = running code disabled
VOX_SANDBOX=docker
# Only when the API runs inside Docker (docker-compose sets it): network shared by the API and preview servers.
# VOX_SANDBOX_NETWORK=voxagent_preview
# Public preview links for running apps via a cloudflared quick tunnel (needs `cloudflared` installed)
VOX_TUNNEL=
# Where people open the app; used in preview links, OAuth redirects and push notification links
VOX_PUBLIC_URL=http://localhost:5173

# ---- Web search: duckduckgo (no key) or searxng:<your SearXNG base URL>
VOX_WEB_SEARCH=duckduckgo

# ---- Gmail + Calendar (same OAuth client as sign-in; add <public url>/integrations/google/callback as a redirect URI)
VOX_GOOGLE_CLIENT_SECRET=
# ---- GitHub OAuth app (optional: users can paste a token instead); callback <public url>/integrations/github/callback
VOX_GITHUB_CLIENT_ID=
VOX_GITHUB_CLIENT_SECRET=
# ---- Deploy: render:<deploy hook URL> or vercel (needs the vercel CLI and VERCEL_TOKEN)
VOX_DEPLOY_PROVIDER=

# ---- Push notifications (reminders, daily briefing): uv run python -m app.push keys
VOX_VAPID_PRIVATE_KEY=
VOX_BRIEFING_HOUR=8

# ---- Bots
VOX_TELEGRAM_TOKEN=
VOX_WHATSAPP_TOKEN=
VOX_WHATSAPP_PHONE_ID=
VOX_WHATSAPP_VERIFY_TOKEN=
VOX_WHATSAPP_APP_SECRET=

# ---- Payments (Stripe Checkout for the paid tier; webhook at <public url>/webhooks/stripe)
VOX_STRIPE_SECRET_KEY=
VOX_STRIPE_PRICE_ID=
VOX_STRIPE_WEBHOOK_SECRET=
